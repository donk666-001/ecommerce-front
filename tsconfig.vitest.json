{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/__tests__/*",
    "env.d.ts",
    "test-utils/**/*"
    // 测试工具文件
  ],
  "exclude": [],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "jsdom"
    ],
    "allowJs": true,
    // 如果测试中需要包含 JS 文件
    "noEmit": true
    // 仅进行类型检查，不输出编译结果
  }
}
